# Secrets
.env
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
venv/
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Data
# Raw pulls and intermediate CSVs stay local. GitHub blocks files over 100 MB.
#
# NOTE the star: `data/processed/*`, not `data/processed/`. Git never descends
# into an excluded DIRECTORY, so a `!` negation can never rescue a file inside
# one. Excluding the CONTENTS instead keeps negation possible.
data/raw/
data/processed/*
*.parquet

# Committed by exception. Last matching pattern wins, so these come after.
#
# crashes.parquet ships so the deployed app has data with no runtime dependency
# (17.7 MB, under GitHub's 50 MB warning). Spec §6 step 2: freeze the full
# derived schema and bake ONCE — every re-bake leaves another permanent ~35 MB
# blob in history that cannot easily be removed later.
!data/processed/crashes.parquet

# Generated by the bake. The corridor figures live here, not in prose — the spec
# used to carry twelve hand-copied counts and none of them reproduced.
!data/processed/corridor_fixture.csv

# Committed reference data, small and hand-curated.
!data/street_aliases.csv
!data/limited_access.csv
!data/countermeasures.csv

# OS / tooling
.DS_Store
Thumbs.db
.gstack/
