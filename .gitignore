# Secrets
.env
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
venv/
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Data
# Raw pulls and intermediate CSVs stay local. GitHub blocks files over 100 MB.
#
# NOTE the star: `data/processed/*`, not `data/processed/`. Git never descends
# into an excluded DIRECTORY, so a `!` negation can never rescue a file inside
# one. Excluding the CONTENTS instead keeps negation possible.
data/raw/*
data/processed/*
*.parquet

# --- Everything below overrides the rules above (last match wins) ---

# Crashes parquet ships so the deployed app has data with no runtime dependency
# (17.7 MB, under GitHub's 50 MB warning).
!data/processed/crashes.parquet

# EB model inputs. Small enough to ship (~2 MB combined).
!data/raw/eb_cells.parquet
!data/raw/corridor_features.parquet

# Corridor figures generated by the bake.
!data/processed/corridor_fixture.csv

# Committed reference data, small and hand-curated.
!data/street_aliases.csv
!data/limited_access.csv
!data/countermeasures.csv

# OS / tooling
.DS_Store
Thumbs.db
.gstack/
